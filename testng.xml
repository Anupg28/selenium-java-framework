<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Selenium Java Framework Suite" verbose="1">

    <listeners>
        <listener class-name="com.anup.framework.listeners.RetryTransformer"/>
    </listeners>

    <test name="Login and Registration">
        <classes>
            <class name="com.anup.framework.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Product Search">
        <classes>
            <class name="com.anup.framework.tests.SearchProductTest"/>
        </classes>
    </test>

    <test name="Add To Cart">
        <classes>
            <class name="com.anup.framework.tests.AddToCartTest"/>
        </classes>
    </test>

    <test name="Checkout Flow">
        <classes>
            <class name="com.anup.framework.tests.CheckoutTest"/>
        </classes>
    </test>

</suite>
